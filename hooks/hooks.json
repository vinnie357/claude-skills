{
  "description": "Core attribution guard and startup contract for all-skills",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "nu \"${CLAUDE_PLUGIN_ROOT}/plugins/core/skills/git/hooks/block-attribution.nu\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/plugins/core/hooks/session-start.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
